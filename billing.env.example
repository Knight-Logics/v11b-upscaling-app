# Local developer configuration only. Never commit real credentials.
# Public builds must use a server-side billing API; never ship Stripe or SMTP
# secret keys inside PixelForge-AI.exe.

V11B_BILLING_API_BASE=https://knightlogics.com
V11B_FREE_TRIAL_CREDITS=20
V11B_DISABLE_ANONYMOUS_DIAGNOSTICS=0

# Local-only embedded checkout testing (never package these values):
V11B_DEV_MODE=0
# V11B_BILLING_API_BASE=embedded://local
STRIPE_SECRET_KEY=
V11B_STRIPE_SUCCESS_URL=http://127.0.0.1:5050/payment_success?session_id={CHECKOUT_SESSION_ID}
V11B_STRIPE_CANCEL_URL=http://127.0.0.1:5050/payment_cancel
